# Day 31: generation only. Embeddings (Day 29) run locally and need no key.
# Groq's chat endpoint is real (unlike their embeddings endpoint, which
# does not exist, despite some third-party client libraries implying
# otherwise -- confirmed the hard way while building this project).
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
